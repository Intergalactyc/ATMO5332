&share
 wrf_core             = 'ARW'
 max_dom              = 3
 start_date           = '2026-09-01_03:00:00', '2026-09-01_03:00:00', '2026-09-01_03:00:00'
 end_date             = '2026-09-01_18:00:00', '2026-09-01_18:00:00', '2026-09-01_18:00:00'
 interval_seconds     = 21600
 io_form_geogrid      = 2
 debug_level          = 0
/

&geogrid
 parent_id            = 1, 1, 2
 parent_grid_ratio    = 1, 3, 3
 i_parent_start       = 1, 81, 80
 j_parent_start       = 1, 66, 75
 e_we                 = 251, 280, 367
 e_sn                 = 221, 271, 367
 geog_data_res        = 'default', 'default', 'default'
 dx                   = 9000
 dy                   = 9000
 map_proj             = 'lambert'
 ref_lat              = 33.610
 ref_lon              = -102.050
 truelat1             = 30
 truelat2             = 37
 pole_lat             = 90
 pole_lon             = 0
 stand_lon            = -102.050
 geog_data_path       = 'geog'
 opt_geogrid_tbl_path = './geogrid/'
/

&ungrib
 out_format           = 'WPS'
 prefix               = 'FILE'
/

&metgrid
 fg_name              = 'FILE'
 io_form_metgrid      = 2
 opt_metgrid_tbl_path = './metgrid'
/

